# =====================
# GLOBAL
# =====================
ENV=local
PLATFORM_NAME=polyhorizon
GITHUB_REPOSITORY=your-org/polyhorizon
FEAST_PROJECT_NAME=features
IMAGE_TAG=sha-0000000

# Spark package versions (single source of truth)
DELTA_SPARK_VERSION=3.3.2
SPARK_SQL_KAFKA_VERSION=3.5.7
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262
STREAMING_SPARK_IMAGE=ghcr.io/your-org/polyhorizon/spark-streaming:${IMAGE_TAG}

# Shared service defaults (override container endpoints for local host commands)
POSTGRES_CONNECT_TIMEOUT=10
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=admin_sillians
AWS_SECRET_ACCESS_KEY=REPLACE_ME
INTERNAL_SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_S3_BUCKETS=sp500companiesdata,polyhorizon-streamingdata,mlflow-artifacts,offline-store,feature-registry
MLFLOW_BUCKET_NAME=mlflow-artifacts
FEAST_OFFLINE_BUCKET=offline-store
FEAST_REGISTRY_BUCKET=feature-registry
SP500COMPANIES=sp500companiesdata
STREAMINGDATA_BUCKET=polyhorizon-streamingdata
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=3
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=REPLACE_ME

# Shared logging defaults
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FORMAT=%(asctime)s | %(name)s | %(levelname)s | %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_TO_FILE=false
LOG_JSON_FORMAT=true
MAX_LOG_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# Ingestion and streaming defaults
FINNHUB_TOKEN=REPLACE_ME
FINNHUB_WS_URL=wss://ws.finnhub.io
MAX_SYMBOLS_PER_CONNECTION=50
MAX_TOTAL_SYMBOLS=3
SUBSCRIPTION_DELAY_SECONDS=1
CONNECTION_RETRY_DELAY=5
RATE_LIMIT_DELAY=1
MAX_RETRIES=5
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_CLOSE_TIMEOUT=10
WS_MAX_MESSAGE_SIZE=1048576
KAFKA_SERVERS=kafka-broker-1:29092,kafka-broker-2:29093,kafka-broker-3:29094
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:29092,kafka-broker-2:29093,kafka-broker-3:29094
KAFKA_TOPIC=stock_trades
CONSUMER_GROUP_ID=polyhorizon-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_AUTO_COMMIT_INTERVAL_MS=1000
KAFKA_SESSION_TIMEOUT_MS=18000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_POLL_RECORDS=500
KAFKA_CONSUMER_TIMEOUT_MS=5000
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_MAX_IN_FLIGHT=1
CONSUMER_BATCH_PROCESSING=false
CONSUMER_BATCH_SIZE=100
CONSUMER_PROCESSING_TIMEOUT=30
CONSUMER_METRICS_INTERVAL=50
CONSUMER_HEALTH_CHECK_INTERVAL=30
CONSUMER_MAX_CONSECUTIVE_ERRORS=10
CONSUMER_ERROR_BACKOFF_SECONDS=5
TICKERS_CSV=s3://sp500companiesdata/sp500_companies.csv
SP500_URL=https://en.wikipedia.org/wiki/List_of_S%26P_500_companies
BRONZE_PATH=s3a://polyhorizon-streamingdata/bronze
GOLD_PATH=s3a://polyhorizon-streamingdata/gold
CHECKPOINT_BRONZE=s3a://polyhorizon-streamingdata/checkpoints/bronze
CHECKPOINT_GOLD=s3a://polyhorizon-streamingdata/checkpoints/gold
FEATURE_OUTPUT_PATH=s3a://polyhorizon-streamingdata/features
MAINTENANCE_INTERVAL=3600
RETENTION_HOURS=720
SPARK_MASTER_URL=local[*]
SPARK_LOG_LEVEL=WARN


# =====================
# POSTGRES
# =====================
POSTGRES_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_CONNECT_TIMEOUT=10

POSTGRES_APP_DB=app_db
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=REPLACE_ME

POSTGRES_MLFLOW_DB=mlflow_db
POSTGRES_MLFLOW_USER=mlflow_user
POSTGRES_MLFLOW_PASSWORD=REPLACE_ME

POSTGRES_FEAST_DB=feature_store_db
POSTGRES_FEAST_USER=feast_user
POSTGRES_FEAST_PASSWORD=REPLACE_ME
FEAST_SCHEMA=feast_schema

# Feast registry metadata has its own least-privilege database role.
POSTGRES_FEAST_REGISTRY_DB=feast_registry_db
POSTGRES_FEAST_REGISTRY_USER=feast_registry_user
POSTGRES_FEAST_REGISTRY_PASSWORD=REPLACE_ME
FEAST_REGISTRY_SCHEMA=feast_registry

POSTGRES_MONITOR_USER=postgres_monitor
POSTGRES_MONITOR_PASSWORD=REPLACE_ME
POSTGRES_BACKUP_RETENTION_DAYS=14

# Features metrics
FEATURES_ENABLE_METRICS=true
FEATURES_PUSHGATEWAY_URL=prometheus-pushgateway:9091
FEATURES_METRICS_PREFIX=features

# Training metrics
TRAINING_ENABLE_METRICS=true
TRAINING_PUSHGATEWAY_URL=prometheus-pushgateway:9091
TRAINING_METRICS_PREFIX=training

# =====================
# SERVING
# =====================
SERVING_HOST=0.0.0.0
SERVING_PORT=8000
SERVING_CORS_ORIGINS=*
SERVING_REQUEST_TIMEOUT=30
SERVING_ENABLE_METRICS=true
SERVING_METRICS_PATH=/metrics
SERVING_REQUIRE_API_KEY=false
SERVING_API_KEYS=
# Separate operator-only credentials for /ops/session, feature debug and model reload.
SERVING_OPERATOR_API_KEYS=
SERVING_API_KEY_HEADER=X-API-Key
SERVING_RATE_LIMIT_ENABLED=false
SERVING_RATE_LIMIT_PER_MINUTE=60
SERVING_RATE_LIMIT_PREFIX=serving:rate-limit
SERVING_AUTH_EXEMPT_PATHS=/v1/health,/v1/health/live,/v1/health/ready,/v1/metadata,/metrics
SERVING_WARMUP_ENABLED=true
SERVING_FEATURE_DEBUG_ENABLED=false
SERVING_MODEL_RELOAD_ENABLED=false
SERVING_ACTIVATION_MODE=none
SERVING_RELOAD_URL=http://model-serving:8000/v1/model/reload
SERVING_RELOAD_API_KEY=
SERVING_REPLICAS=1
SERVING_ROLLING_REPLICAS=2
UNIVERSE_CURRENT_KEY=universe/current.json
UNIVERSE_MAX_AGE_HOURS=30
SERVING_REDIS_ENABLED=true
SERVING_REDIS_DB=0
SERVING_REDIS_PASSWORD=
SERVING_CACHE_TTL=300
SERVING_HISTORY_ROWS=780
SERVING_FORECAST_HORIZON=39
SERVING_FORECAST_QUANTILES=0.1,0.5,0.9
SERVING_FORECAST_TARGET_TYPE=return
SERVING_FORECAST_BASE_PRICE_FEATURE=close
SERVING_RETURN_METHOD=log
SERVING_TFT_MAX_ENCODER_LENGTH=780
SERVING_TFT_MAX_PREDICTION_LENGTH=39
SERVING_TFT_TIME_IDX_FIELD=time_idx
SERVING_TFT_TIME_FIELD=event_timestamp
SERVING_TFT_GROUP_ID_FIELD=symbol
SERVING_TFT_FREQ=30min
SERVING_TFT_TARGET=target
SERVING_TFT_UNKNOWN_REALS=open,high,low,close,total_volume,rolling_avg_close,rolling_volatility_close,log_volume,log_close,target
SERVING_FEATURE_REFS=stock_ohlcv_features:open,stock_ohlcv_features:high,stock_ohlcv_features:low,stock_ohlcv_features:close,stock_ohlcv_features:total_volume,stock_ohlcv_features:rolling_avg_close,stock_ohlcv_features:rolling_volatility_close,stock_ohlcv_features:event_timestamp

# Traefik / Load Balancer (production)
POLYHORIZON_DOMAIN=app.polyhorizon.com
TRAEFIK_ACME_EMAIL=REPLACE_ME@example.com
SERVING_CORS_ORIGINS=https://app.polyhorizon.com
TRAEFIK_DASHBOARD_DOMAIN=traefik.app.polyhorizon.com
TRAEFIK_DASHBOARD_USERS=admin:REPLACE_WITH_BCRYPT_HTPASSWD_HASH
TRAEFIK_API_RATE_LIMIT_AVERAGE=60
TRAEFIK_API_RATE_LIMIT_BURST=30
TRAEFIK_API_MAX_INFLIGHT=32
ALERTMANAGER_SLACK_WEBHOOK_FILE=./monitoring/secrets/alertmanager_slack_url.example
MLFLOW_DOMAIN=mlflow.app.polyhorizon.com
PREFECT_DOMAIN=prefect.app.polyhorizon.com
GRAFANA_DOMAIN=grafana.app.polyhorizon.com
PROMETHEUS_DOMAIN=prometheus.app.polyhorizon.com
ALERTMANAGER_DOMAIN=alertmanager.app.polyhorizon.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME


# Frontend
# FRONTEND_API_BASE_URL=https://app.polyhorizon.com
# For local development builds:
FRONTEND_API_BASE_URL=http://localhost:8000



# MLflow + model registry
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow_user:REPLACE_ME@localhost:5433/mlflow_db
MODEL_REGISTRY_NAME=StockTFT_Quantile
MODEL_CHAMPION_ALIAS=champion
MODEL_CHALLENGER_ALIAS=challenger
MODEL_ARTIFACT_PATH=tft_model

# Feast repo paths (serving)
FEAST_REPO_PATH=polyhorizon/features/feature_repo
FEAST_STORE_YAML=polyhorizon/features/feature_repo/feature_store.yaml
FEAST_FEATURE_VIEW=stock_ohlcv_features

POSTGRES_PREFECT_DB=prefect_db
POSTGRES_PREFECT_USER=prefect_user
POSTGRES_PREFECT_PASSWORD=REPLACE_ME


DEAD_LETTER_PATH=s3a://polyhorizon-streamingdata/dead_letter
CHECKPOINT_DEAD_LETTER=s3a://polyhorizon-streamingdata/checkpoints/dead_letter

# Data and Feast names used by the training, features, and serving configs
DB_SCHEMA=feast_schema
OFFLINE_TABLE_NAME=stock_ohlcv
SNAPSHOT_TABLE_NAME=stock_ohlcv_training_snapshot
SNAPSHOT_DAYS=180
FEATURE_OUTPUT_PATH=s3a://polyhorizon-streamingdata/features
# Legacy manual loader alias. Production publication reads a manifest-pinned dataset.
FEATURE_PARQUET_PATH=${FEATURE_OUTPUT_PATH}
SP500COMPANIES_DATA=s3a://sp500companiesdata/sp500_companies.csv
SYMBOLS_BUCKET=sp500companiesdata
SYMBOLS_KEY=sp500_companies.csv
